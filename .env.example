# Copy this file to .env and fill in real values before running the server.

# Port the server listens on
PORT=3000

# Secret key required to access /api/admin/* routes and the admin.html dashboard.
# Make this long and random — anyone with this key can see registrations and
# rewrite the leaderboard, schedule, and news.
ADMIN_KEY=change-this-to-a-long-random-secret

# Razorpay keys — get these from https://dashboard.razorpay.com/app/keys
# Leave blank to keep paid-entry tournaments disabled (free tournaments still work).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Push notification keys (VAPID) — needed for match-start alerts.
# Generate your own pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank to keep push notifications disabled (everything else still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret used to sign player login sessions (JWTs). Make this long and random —
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Email used to send "forgot password" OTP emails to players — sent via
# Brevo's HTTPS API (NOT Gmail SMTP, since most hosts including Render's
# free tier block outbound SMTP ports 25/465/587 to fight spam).
#
# Setup (free, ~5 minutes):
#   1. Sign up at https://www.brevo.com (no card needed)
#   2. Settings → Senders & IP → add SMTP_EMAIL below as a sender, verify it
#      via the confirmation email Brevo sends you
#   3. Settings → API Keys → Generate a new API key → paste as BREVO_API_KEY
#   4. Free tier sends up to 300 emails/day, plenty for this site
#
# Leave both blank to disable password reset emails.
SMTP_EMAIL=
BREVO_API_KEY=

# Postgres connection string for storing registrations permanently.
# Leave blank to use a local JSON file instead (fine for testing, but data can
# be lost on some hosting platforms when the service restarts or redeploys).
# Get a free one from https://neon.tech (no card, no expiry on the free tier).
# Looks like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
